{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MultimodalAnalysisOutput",
  "description": "Structured JSON schema for Google AI Studio frontier model multimodal reasoning.",
  "type": "object",
  "required": [
    "summary",
    "entities",
    "actionDirectives",
    "reasoningSteps"
  ],
  "additionalProperties": true,
  "properties": {
    "sessionId": {
      "type": "string",
      "description": "Unique session identifier for multi-turn conversational tracing."
    },
    "latencyMs": {
      "type": "integer",
      "description": "End-to-end execution latency in milliseconds."
    },
    "summary": {
      "type": "string",
      "description": "High-density synthesis of input text, imagery, audio, or document data."
    },
    "sentiment": {
      "type": "string",
      "enum": [
        "POSITIVE",
        "NEUTRAL",
        "NEGATIVE",
        "MIXED"
      ],
      "default": "NEUTRAL",
      "description": "Inferred emotional or operational tone."
    },
    "confidenceScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.9,
      "description": "Aggregate statistical confidence across multimodal streams."
    },
    "acousticAnalysis": {
      "type": "object",
      "properties": {
        "transcript": {
          "type": "string"
        },
        "audioCharacteristics": {
          "type": "string"
        },
        "detectedAnomalies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "vaultGrounding": {
      "type": "object",
      "properties": {
        "fileName": {
          "type": "string"
        },
        "driveUrl": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "sizeBytes": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": [
            "GROUNDED_ZERO_LOCAL_IO",
            "DIRECT_DRIVE_REF"
          ]
        }
      }
    },
    "entities": {
      "type": "array",
      "description": "Extracted key subjects, technological components, or temporal anchors.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "category",
          "confidence"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "actionDirectives": {
      "type": "array",
      "description": "Deterministic directives recommended for client or cloud execution.",
      "items": {
        "type": "object",
        "required": [
          "priority",
          "instruction"
        ],
        "properties": {
          "priority": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "instruction": {
            "type": "string"
          }
        }
      }
    },
    "reasoningSteps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
